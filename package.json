{
  "name": "vessels-events",
  "version": "0.2.0",
  "private": true,
  "description": "Vessels Events: the desktop show launcher for live Vessels nights (operator console + projector display).",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "start:sample": "electron . --show=shows/sample-show/show.json",
    "test": "node --test \"tests/*.test.mjs\" \"web/*.test.mjs\"",
    "smoke": "node tools/smoke.mjs",
    "check:phones": "node tools/phones-check.mjs",
    "check:night": "node tools/launcher-check.mjs",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File web/deploy.ps1 -Show shows/sample-show/show.json"
  },
  "author": "Dojo Disco LLC",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^37.10.3",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^24.43.1"
  },
  "dependencies": {
    "qrcode-generator": "^1.4.4"
  }
}
